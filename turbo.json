{
	"$schema": "https://turborepo.com/schema.json",
	"ui": "tui",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"env": ["MEMONGO_WEB_STATIC_EXPORT", "NEXT_PUBLIC_MEMONGO_API_URL"],
			"inputs": ["$TURBO_DEFAULT$", ".env*"],
			"outputs": [
				".next/**",
				"!.next/cache/**",
				"dist/**",
				".turbo/docs-integrity.txt"
			]
		},
		"test": {
			"dependsOn": ["^build"],
			"outputs": []
		},
		"test:e2e": {
			"dependsOn": ["^build"],
			"cache": false,
			"env": [
				"MONGODB_TEST_URI",
				"MEMONGO_TEST_MONGODB_URI",
				"VOYAGE_API_KEY",
				"MEMONGO_E2E_TIER"
			],
			"outputs": []
		},
		"lint": {
			"dependsOn": ["^lint"]
		},
		"check-types": {
			"dependsOn": ["^build", "^check-types"]
		},
		"dev": {
			"cache": false,
			"persistent": true
		}
	}
}
