{
	"name": "@memongo/tools",
	"version": "2.0.1",
	"description": "AI SDK tool helpers for Memongo (function-calling tools for search, add, profile, etc.)",
	"type": "module",
	"engines": {
		"node": ">=20.19.0"
	},
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/romiluz13/memongo.git",
		"directory": "packages/tools"
	},
	"author": "Rom Iluz",
	"keywords": [
		"memongo",
		"tools",
		"ai-sdk",
		"memory",
		"mongodb"
	],
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"README.md"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./vercel": {
			"types": "./dist/vercel/index.d.ts",
			"default": "./dist/vercel/index.js"
		},
		"./openai": {
			"types": "./dist/openai/index.d.ts",
			"default": "./dist/openai/index.js"
		}
	},
	"scripts": {
		"clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
		"build": "bun run clean && node ../../node_modules/typescript/bin/tsc -p tsconfig.json",
		"check-types": "node ../../node_modules/typescript/bin/tsc --noEmit -p tsconfig.json",
		"test": "vitest run",
		"prepublishOnly": "bun run build"
	},
	"dependencies": {
		"@memongo/client": "^2.0.1",
		"@memongo/lib": "^2.0.1",
		"zod": "^3.25.0"
	},
	"devDependencies": {
		"ai": "^5.0.237",
		"typescript": "^5.8.0",
		"vitest": "^4.1.10"
	},
	"peerDependencies": {
		"ai": ">=5.0.0"
	},
	"homepage": "https://github.com/romiluz13/memongo#readme",
	"bugs": {
		"url": "https://github.com/romiluz13/memongo/issues"
	}
}
