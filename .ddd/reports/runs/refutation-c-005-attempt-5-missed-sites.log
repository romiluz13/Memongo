    99	/**
   100	 * Project conversation windows into the chunks collection.
   101	 * Each window becomes a chunk at `windows/{sessionId}/{windowIndex}`.
   102	 * Idempotent: uses upsert with path as unique key.
   103	 *
   104	 * Fetches all events for the session, builds windows, and upserts chunks.
   105	 */
   106	export async function projectConversationWindows(params: {
   107		db: Db
   108		prefix: string
   109		agentId: string
   110		sessionId: string
   111		scope: MemoryScope
   112		scopeRef: string
   113		windowSize?: number
   114		overlap?: number
   115	}): Promise<{ windowsCreated: number }> {
   116		const { db, prefix, agentId, sessionId, scope, scopeRef } = params
   117		const windowSize = params.windowSize ?? 7
   118		const overlap = params.overlap ?? 2
   119	
   120		// Fetch all events for this session
   121		const eventsCol = eventsCollection(db, prefix)
   122		const rawResult = await eventsCol
   123			.find({ agentId, sessionId })
   124			.sort({ timestamp: 1 })
   125			.limit(1000)
   126			.toArray()
   127		const sessionEvents = rawResult as unknown as Array<{
   128			eventId: string
   129			role: string
   130			body: string
   131			timestamp: Date
   132		}>
   133		if (!Array.isArray(sessionEvents) || sessionEvents.length === 0) {
   134			return { windowsCreated: 0 }
   135		}
   136	
   137		const windows = buildConversationWindows(
   138			sessionId,
   139			sessionEvents,
   140			windowSize,
   141			overlap,
   142		)
   143	
   144		if (windows.length === 0) {
   145			return { windowsCreated: 0 }
   146		}
   147	
   148		const chunks = chunksCollection(db, prefix)
   149		let windowsCreated = 0
   150	
   151		for (const win of windows) {
   152			const path = `windows/${sessionId}/${win.windowIndex}`
   153			const hash = createHash("sha256").update(win.text).digest("hex")
   154			const now = new Date()
   155	
   156			await chunks.updateOne(
   157				{ path },
   158				{
   159					$set: {
   160						text: win.text,
   161						hash,
   162						source: "conversation",
   163						agentId,
   164						scope,
   165						scopeRef,
   166						updatedAt: now,
   167						sessionId,
   168						windowIndex: win.windowIndex,
   169						timestamp: win.events[0].timestamp,
   170					},
   171					$setOnInsert: {
   172						path,
   173						createdAt: now,
   174					},
   175				},
   176				{ upsert: true },

