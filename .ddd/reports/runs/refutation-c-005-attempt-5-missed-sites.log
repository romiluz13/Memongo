    54	export async function getMemoryStats(
    55		db: Db,
    56		prefix: string,
    57		validPaths?: Set<string>,
    58		options: MemoryStatsOptions = {},
    59	): Promise<MemoryStats> {
    60		const chunksCol = chunksCollection(db, prefix)
    61		const filesCol = filesCollection(db, prefix)
    62	
    63		// Per-source file breakdown
    64		const sourceAgg: Document[] = await filesCol
    65			.aggregate([
    66				{
    67					$group: {
    68						_id: "$source",
    69						count: { $sum: 1 },
    70						lastSync: { $max: "$updatedAt" },
    71					},
    72				},
    73			])
    74			.toArray()
    75	
    76		const sources: MemorySourceStats[] = sourceAgg.map((doc) => ({
    77			source: String(doc._id ?? "unknown"),
    78			fileCount: doc.count as number,
    79			chunkCount: 0, // filled below
    80			lastSync: doc.lastSync instanceof Date ? doc.lastSync : null,
    81		}))
    82	
    83		// Per-source chunk counts
    84		const chunkSourceAgg: Document[] = await chunksCol
    85			.aggregate([{ $group: { _id: "$source", count: { $sum: 1 } } }])
    86			.toArray()
    87	
    88		for (const doc of chunkSourceAgg) {
    89			const src = sources.find((s) => s.source === String(doc._id))
    90			if (src) {
    91				src.chunkCount = doc.count as number
    92			}
    93		}
    94	
    95		const embeddingMode = options.embeddingMode ?? "client"
    96		const chunkMeasurement = await measureEmbeddingCoverage({
    97			collection: chunksCol,
    98			indexName: `${prefix}chunks_vector`,
    99			embeddingMode,
   100		})
   101		const withEmb = chunkMeasurement.success
   102		const totalChunks = chunkMeasurement.total
   103		const embeddingCoverage: EmbeddingCoverage = {
   104			withEmbedding: withEmb,
   105			withoutEmbedding: chunkMeasurement.pending,
   140		// $indexStats: show which indexes are used and which are unused
   141		const indexStats = await aggregateIndexStats(db, prefix)
   142	
   143		// Collection document counts
   144		const totalFiles = await filesCol.countDocuments()
   145	
   146		log.info(
   147			`stats: files=${totalFiles} chunks=${totalChunks} ` +
   148				`embeddingStatus={basis=${embeddingStatusCoverage.basis},success=${embeddingStatusCoverage.success},failed=${embeddingStatusCoverage.failed},pending=${embeddingStatusCoverage.pending},unknown=${embeddingStatusCoverage.unknown}} ` +
   149				`stale=${staleFiles.length}`,
   150		)
   151	
   152		return {
   153			sources,
   154			totalFiles,
   155			totalChunks,
   156			embeddingCoverage,
   157			embeddingStatusCoverage,
   158			staleFiles,
   159			collectionSizes: {
   160				files: totalFiles,
   161				chunks: totalChunks,
   162			},
