{
	"name": "memongo",
	"version": "2.0.1",
	"private": true,
	"description": "MongoDB-native long-term AI memory with reasoning chains, novelty detection, and consolidation: engine, SDK, HTTP API, MCP server, and web console",
	"license": "Apache-2.0",
	"packageManager": "bun@1.3.13",
	"engines": {
		"node": ">=20.19.0"
	},
	"workspaces": [
		"apps/*",
		"packages/*",
		"scripts"
	],
	"overrides": {
		"body-parser": "2.3.0",
		"fast-uri": "3.1.5",
		"fast-xml-builder": "1.3.1",
		"fast-xml-parser": "5.11.0",
		"form-data": "4.0.6",
		"ip-address": "10.5.0",
		"lodash": "4.18.1",
		"postcss": "8.5.26",
		"qs": "6.15.3",
		"react": "19.2.8",
		"socket.io-parser": "4.2.7",
		"tar": "7.5.22",
		"vite": "8.2.1",
		"ws": "8.21.3"
	},
	"scripts": {
		"build": "turbo run build",
		"dev": "turbo run dev",
		"test": "turbo run test",
		"test:e2e": "turbo run test:e2e",
		"check-types": "turbo run check-types",
		"check-publishability": "bun scripts/check-publishability.ts",
		"lint": "biome check . --diagnostic-level=error",
		"lint:fix": "biome check . --diagnostic-level=error --write",
		"format": "biome format .",
		"format:fix": "biome format --write .",
		"web:preview": "bun run --cwd apps/web preview",
		"web:deploy": "bun run --cwd apps/web deploy",
		"proof-pack": "bun scripts/proof-pack.ts",
		"mongodb:parity": "bun scripts/check-mongodb-runtime-parity.ts",
		"mongodb:prepare": "bun scripts/prepare-mongodb-runtime.ts",
		"mongodb:cluster-preflight": "bun scripts/mongodb-cluster-preflight.ts",
		"memory-eval": "bun scripts/real-memory-eval.ts",
		"compare-memory-eval": "bun scripts/compare-memory-eval.ts",
		"agent-smoke": "bun scripts/real-agent-smoke.ts",
		"capability-stress": "bun scripts/real-capability-stress.ts",
		"benchmark:fetch": "bun scripts/fetch-benchmark-dataset.ts",
		"benchmark": "turbo run build --filter=@memongo/memory-bridge... --output-logs=errors-only && bun scripts/run-benchmark.ts"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.10",
		"fast-check": "^4.9.0",
		"turbo": "^2.10.10",
		"typescript": "^5.9.3"
	}
}
