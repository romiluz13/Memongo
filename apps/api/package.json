{
	"name": "@memongo/api",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "HTTP API server for the Memongo memory platform",
	"scripts": {
		"start": "node --import tsx src/server.ts",
		"dev": "node --import tsx --watch src/server.ts",
		"build": "node ../../node_modules/typescript/bin/tsc -p tsconfig.json --noEmit false --rootDir src --outDir dist",
		"check-types": "node ../../node_modules/typescript/bin/tsc --noEmit -p tsconfig.json",
		"test": "vitest run src/app.test.ts src/app.segment*.test.ts"
	},
	"dependencies": {
		"@hono/node-server": "^1.19.17",
		"@memongo/lib": "workspace:*",
		"@memongo/memory-bridge": "workspace:*",
		"hono": "^4.13.2",
		"tsx": "^4.23.12",
		"zod": "^3.25.0"
	},
	"devDependencies": {
		"@types/node": "^22.20.1",
		"typescript": "^5.8.0",
		"vitest": "^4.1.10"
	}
}
