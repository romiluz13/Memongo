{
	"name": "@memongo/mcp",
	"version": "2.0.1",
	"description": "MCP server for Memongo (stdio + streamable HTTP; calls the Memongo HTTP API)",
	"type": "module",
	"engines": {
		"node": ">=20.19.0"
	},
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/romiluz13/memongo.git",
		"directory": "apps/mcp"
	},
	"author": "Rom Iluz",
	"keywords": [
		"memongo",
		"mcp",
		"model-context-protocol",
		"mongodb",
		"memory"
	],
	"main": "./dist/server.js",
	"types": "./dist/server.d.ts",
	"bin": {
		"memongo-mcp": "./dist/server.js"
	},
	"files": [
		"dist",
		"README.md"
	],
	"exports": {
		".": {
			"types": "./dist/server.d.ts",
			"default": "./dist/server.js"
		}
	},
	"scripts": {
		"start": "node dist/server.js",
		"clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
		"build": "bun run clean && node ../../node_modules/typescript/bin/tsc -p tsconfig.build.json",
		"check-types": "node ../../node_modules/typescript/bin/tsc --noEmit -p tsconfig.json",
		"test": "vitest run src",
		"prepublishOnly": "bun run build"
	},
	"dependencies": {
		"@memongo/client": "^2.0.1",
		"@memongo/lib": "^2.0.1",
		"@modelcontextprotocol/sdk": "^1.30.0"
	},
	"devDependencies": {
		"typescript": "^5.8.0",
		"vitest": "^4.1.10"
	},
	"homepage": "https://github.com/romiluz13/memongo#readme",
	"bugs": {
		"url": "https://github.com/romiluz13/memongo/issues"
	}
}
